in ../qsharp-props.maude

mod LOOPS-PROG is
  pr QSHARP-SYNTAX .
  op prog : -> Decls .
  eq prog =
    *** classical while
    (operation 'Count () : Int {
        mutable 'k = 0 ;
        while 'k lt 3 { set 'k += 1 ; }
        return 'k ;
    })
    *** repeat-until-success: repeat until One is obtained
    (operation 'UntilOne () : Result {
        mutable 'res = Zero ;
        repeat {
            use 'q = Qubit() ;
            'H('q) ;
            let 'r = 'M('q) ;
            'Reset('q) ;
            set 'res = 'r ;
        } until 'r eq One ;
        return 'res ;
    })
    *** fixup that sees the body variables and leaves the qubit in |0>
    (operation 'Fixup () : Result {
        mutable 'res = One ;
        repeat {
            use 'q = Qubit() ;
            'H('q) ;
            let 'r = 'M('q) ;
            set 'res = 'r ;
        } until 'r eq Zero
        fixup {
            'X('q) ;
        }
        return 'res ;
    }) .
endm

mod LOOPS is
  pr QSHARP-PROPS .
  pr LOOPS-PROG .
endm

search run(prog, 'Count) =>! {(result: V:Value) R:Comps} .
search runNP(prog, 'UntilOne) =>! {(result: V:Value) (qstate: Q:Qubit) (prob: P:Prob) R:Comps} .
search runNP(prog, 'Fixup) =>! {(result: V:Value) (qstate: Q:Qubit) (prob: P:Prob) R:Comps} .
*** the state graph of RUS is finite: how many states?
search runNP(prog, 'UntilOne) =>* {(isEnd: true) R:Comps} .
*** with probabilities and a depth bound: the first branches
search [3] run(prog, 'UntilOne) =>! {(result: V:Value) (prob: P:Prob) R:Comps} .
