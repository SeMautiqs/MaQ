*** Lexer run before tokenize: tokenize only splits at ( ) [ ] { } , and keeps
*** 0..n-1, a==b or x+1 together. This lexer:
***   - removes // comments up to the end of the line
***   - turns newlines and tabs into spaces
***   - surrounds Q# operators with spaces, trying the two-character ones
***     first: == != <= >= .. += -= *= =>
***   - leaves string literals "..." untouched
*** A lone dot separates nothing, so Std.Math and 1.0 are preserved.

fmod QSHARP-LEXER is
  pr STRING .

  vars S Acc C1 C2 : String .
  vars I J : Nat .

  op lex : String -> String .
  eq lex(S) = $lex(S, 0, "") .

  op ops2 : String -> Bool .
  eq ops2(C2) = C2 == "==" or C2 == "!=" or C2 == "<=" or C2 == ">=" or C2 == ".."
             or C2 == "+=" or C2 == "-=" or C2 == "*=" or C2 == "=>" .

  op ops1 : String -> Bool .
  eq ops1(C1) = find("+-*/%<>=!;,:()[]{}", C1, 0) =/= notFound .

  op blank : String -> Bool .
  eq blank(C1) = C1 == "\n" or C1 == "\t" or C1 == "\r" .

  op $lex : String Nat String -> String .
  ceq $lex(S, I, Acc) = Acc if I >= length(S) .
  ceq $lex(S, I, Acc) = $lexAt(S, I, Acc, substr(S, I, 1), substr(S, I, 2))
   if I < length(S) .

  op $lexAt : String Nat String String String -> String .
  *** comments
  ceq $lexAt(S, I, Acc, C1, "//") =
      if J :: Nat then $lex(S, J, Acc + " ") else Acc fi
   if J := find(S, "\n", I) .
  eq $lexAt(S, I, Acc, C1, "//") = Acc [owise] .
  *** strings
  ceq $lexAt(S, I, Acc, "\"", C2) = $lex(S, J + 1, Acc + " " + substr(S, I, sd(J + 1, I)) + " ")
   if J := find(S, "\"", I + 1) .
  *** two- and one-character operators, spaces and everything else
  eq $lexAt(S, I, Acc, C1, C2) =
      if ops2(C2) then $lex(S, I + 2, Acc + " " + C2 + " ")
      else if ops1(C1) then $lex(S, I + 1, Acc + " " + C1 + " ")
      else if blank(C1) then $lex(S, I + 1, Acc + " ")
      else $lex(S, I + 1, Acc + C1) fi fi fi [owise] .
endfm
