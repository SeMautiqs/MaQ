*** Properties of quantum states for search and model checking.

in qsharp-semantics.maude

mod QSHARP-PROPS is
  pr QSHARP-SEMANTICS .

  vars V W : Vector . var M : Matrix .

  *** equality up to global phase, for phases 1, -1, i, -i
  op eqUpToPhase : Vector Vector -> Bool .
  eq eqUpToPhase(V, W) =
     V == W or-else V == (-1) . W or-else V == i . W or-else V == ((-1) .* i) . W .

  *** qubitAt returns a Matrix; this version accepts the result as it is
  op eqUpToPhase : Matrix Vector -> Bool .
  eq eqUpToPhase(M, W) = false [owise] .
endm
