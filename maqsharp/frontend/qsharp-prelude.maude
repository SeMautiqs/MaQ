*** Part of the Q# standard library, written in Q# itself. The tool appends this
*** text to every program it loads, so these operations are translated and
*** executed by the same semantics as user code.
***   Measure(bases, qubits): joint measurement in a product of Pauli bases,
***     implemented with an auxiliary qubit that collects the parity
***   ApplyControlledOnInt, ApplyControlledOnBitString: controls on a given
***     basis state (little endian for integers)
***   MResetX: measurement in the X basis followed by a reset
***   Head, Tail, Rest, Most: parts of an array

fmod QSHARP-PRELUDE is
  pr STRING .
  pr QID-LIST .

  op prelude : -> String .
  eq prelude =
    "operation Measure(bases : Pauli[], qubits : Qubit[]) : Result {\n"
    + "  use anc = Qubit();\n"
    + "  for i in 0..Length(qubits) - 1 {\n"
    + "    if bases[i] == PauliX { H(qubits[i]); }\n"
    + "    elif bases[i] == PauliY { Adjoint S(qubits[i]); H(qubits[i]); }\n"
    + "    if bases[i] != PauliI { CNOT(qubits[i], anc); }\n"
    + "  }\n"
    + "  let r = M(anc);\n"
    + "  Reset(anc);\n"
    + "  for i in 0..Length(qubits) - 1 {\n"
    + "    if bases[i] == PauliX { H(qubits[i]); }\n"
    + "    elif bases[i] == PauliY { H(qubits[i]); S(qubits[i]); }\n"
    + "  }\n"
    + "  return r;\n"
    + "}\n"
    + "operation ApplyControlledOnInt(n : Int, op : Qubit => Unit, ctrls : Qubit[], target : Qubit) : Unit {\n"
    + "  mutable k = n;\n"
    + "  for c in ctrls { if k % 2 == 0 { X(c); } set k = k / 2; }\n"
    + "  Controlled op(ctrls, target);\n"
    + "  set k = n;\n"
    + "  for c in ctrls { if k % 2 == 0 { X(c); } set k = k / 2; }\n"
    + "}\n"
    + "operation ApplyControlledOnBitString(bits : Bool[], op : Qubit => Unit, ctrls : Qubit[], target : Qubit) : Unit {\n"
    + "  for i in 0..Length(bits) - 1 { if not bits[i] { X(ctrls[i]); } }\n"
    + "  Controlled op(ctrls[...Length(bits) - 1], target);\n"
    + "  for i in 0..Length(bits) - 1 { if not bits[i] { X(ctrls[i]); } }\n"
    + "}\n"
    + "function Head(a : Qubit[]) : Qubit { return a[0]; }\n"
    + "function Tail(a : Qubit[]) : Qubit { return a[Length(a) - 1]; }\n"
    + "function Rest(a : Qubit[]) : Qubit[] { return a[1...]; }\n"
    + "function Most(a : Qubit[]) : Qubit[] { return a[...Length(a) - 2]; }\n"
    + "operation MResetX(q : Qubit) : Result {\n"
    + "  H(q);\n"
    + "  return MResetZ(q);\n"
    + "}\n" .

  *** operations of the prelude, not listed when a program is loaded
  op preludeOps : -> QidList .
  eq preludeOps = 'Measure 'ApplyControlledOnInt 'ApplyControlledOnBitString 'MResetX
                  'Head 'Tail 'Rest 'Most .
endfm
