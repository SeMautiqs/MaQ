*** LTL model checking of Q# programs.
***
*** It lives in a separate module because it adds the stutter rule on final
*** states, which the model checker needs (it does not accept deadlocks). The tool
*** joins this module with the working one at the metalevel, and dist keeps using
*** the module without stutter.
***
*** Atomic propositions:
***   ended            the program has terminated
***   failed           the program has terminated with a false assertion (Fact)
***   returns(V)       it has terminated returning V
***   qubit(N, V)      qubit N is separated and in state V
***   qubitPh(N, V)    same, up to global phase (±1, ±i)
***   entangled(N)     qubit N is in a block of more than one qubit
***   liveLE(K)        there are at most K live qubits

sload qsharp-props.maude
sload model-checker.maude

mod QSHARP-MC is
  pr QSHARP-PROPS .
  inc MODEL-CHECKER .
  inc LTL-SIMPLIFIER .

  subsort Config < State .

  vars R : Comps . vars V V' : Value . var QS : Qubit . vars N K : Nat .
  var W : Vector . var NL : NatList . var Vc : Vector . var Pp : Prop .

  ops ended failed : -> Prop [ctor] .
  op returns : Value -> Prop [ctor] .
  ops qubit qubitPh : Nat Vector -> Prop [ctor] .
  op entangled : Nat -> Prop [ctor] .
  op liveLE : Nat -> Prop [ctor] .

  op nQubits : Qubit -> Nat .
  eq nQubits(emp) = 0 .
  eq nQubits((q[NL]: Vc) QS) = size(NL) + nQubits(QS) .

  op inBig : Qubit Nat -> Bool .
  eq inBig((q[NL]: Vc) QS, N) = (occurs(N, NL) and size(NL) > 1) or inBig(QS, N) .
  eq inBig(emp, N) = false .

  eq {(isEnd: true) R} |= ended = true .
  eq {(isEnd: true) (result: assertionFailed) R} |= failed = true .
  eq {(isEnd: true) (result: V) R} |= returns(V') = V == V' .
  eq {(qstate: QS) R} |= qubit(N, W) = qubitAt(QS, N) == W .
  eq {(qstate: QS) R} |= qubitPh(N, W) = eqUpToPhase(qubitAt(QS, N), W) .
  eq {(qstate: QS) R} |= entangled(N) = inBig(QS, N) .
  eq {(qstate: QS) R} |= liveLE(K) = nQubits(QS) <= K .
  eq C:Config |= Pp = false [owise] .

  rl [stutter] : {(isEnd: true) R} => {(isEnd: true) R} .
endm
