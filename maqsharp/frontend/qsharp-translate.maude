*** Metalevel translation of the Q# surface syntax (the result of metaParse
*** in QSHARP-GRAMMAR) into QSHARP-SYNTAX terms.
***
*** Besides renaming, the translation desugars:
***   - calls inside expressions: they are extracted into temporaries $t0, $t1, ...
***     from left to right, e.g.  if M(q) == One { }  becomes
***     let '$t0 = 'M('q) ; if '$t0 eq One { }
***     In repeat-until, the prologue of the condition goes at the end of the body.
***     It is not supported in while, since the condition is re-evaluated: left untranslated.
***   - elif  ->  else { if ... }
***   - set x -= e  ->  set x = x - e
***   - function  ->  operation;  is Adj + Ctl, @EntryPoint, import and namespace are ignored
***
*** This module imports only META-LEVEL: QSHARP-SYNTAX cannot coexist with
*** META-LEVEL because Qid < Exp makes _,_ and _[_] clash with those of META-TERM.

fmod QSHARP-TRANSLATE is
  pr META-LEVEL .
  pr CONVERSION .

  vars T T' A B C E X F Ty Blk Ss El Sp : Term .
  vars P P1 P2 P3 E1 E2 E3 D : Term .
  var TL : TermList . var NeTL : NeTermList .
  vars N N1 N2 N3 N4 : Nat .
  vars Q Q' : Qid .

  op skipS : -> Term .
  eq skipS = 'skip.Stmts .

  op seq : Term Term -> Term .
  eq seq('skip.Stmts, T) = T .
  eq seq(T, 'skip.Stmts) = T .
  eq seq(T, T') = '__[T, T'] [owise] .

  *** ---------- atoms ----------
  op atom : Term -> Term .
  ceq atom(T) = trAtom(Q, rat(string(Q), 10)) if Q := downTerm(T, 'err) .
  op trAtom : Qid [Rat] -> Term .
  eq trAtom(Q, N) = upTerm(N) .
  eq trAtom('true, R:[Rat]) = 'true.QBool .
  eq trAtom('false, R:[Rat]) = 'false.QBool .
  eq trAtom('Zero, R:[Rat]) = 'Zero.Result .
  eq trAtom('One, R:[Rat]) = 'One.Result .
  ceq trAtom(Q, R:[Rat]) = 'dbl[upTerm(R':Rat), upTerm(0)]
   if R':Rat := decRat(string(Q)) .   *** Double literals such as 4.0 or .5
  op decRat : String ~> Rat .
  ceq decRat(S:String) = rat(substr(S:String, 0, I:Nat) + substr(S:String, s I:Nat, length(S:String)), 10)
                         / (10 ^ sd(length(S:String), s I:Nat))
   if I:Nat := find(S:String, ".", 0) .
  eq trAtom(Q, R:[Rat]) = qcon(Q) [owise] .

  *** metarepresentation of the QSHARP-SYNTAX Qid constant 'x: ''x.Qid
  *** (upTerm would give ''x.Sort, because in META-LEVEL Qids are also sorts)
  op qcon : Qid -> Term .
  eq qcon(Q) = qid("'" + string(Q) + ".Qid") .
  op qc : Term -> Term .   *** from the argument of a 'token
  eq qc(T) = qcon(downTerm(T, 'err)) .

  *** name of a callable without its namespace: Std.Diagnostics.DumpMachine -> DumpMachine
  op base : Term -> Qid .
  eq base(T) = baseQ(downTerm(T, 'err)) .
  op baseQ : Qid -> Qid .
  eq baseQ(Q) = if rfind(string(Q), ".", length(string(Q))) == notFound then Q
                else qid(substr(string(Q), s rfind(string(Q), ".", length(string(Q))),
                                length(string(Q)))) fi .

  *** calls that are ignored: diagnostics and messages
  op ignored : Qid -> Bool .
  eq ignored(Q) = Q == 'Message or Q == 'DumpMachine or Q == 'DumpRegister 
                  or Q == 'DumpOperation or Q == 'DumpRelabelledMachine .

  *** ApplyToEach and its variants
  op applyEach : Qid -> Bool .
  eq applyEach(Q) = Q == 'ApplyToEach or Q == 'ApplyToEachA or Q == 'ApplyToEachC
                    or Q == 'ApplyToEachCA .

  op tmp : Nat -> Term .
  eq tmp(N) = qcon(qid("$t" + string(N, 10))) .

  *** ---------- expressions with call extraction ----------
  sort HRes .
  op h : Term Term Nat -> HRes [ctor] .   *** prologue, expression, counter

  op binop : Qid ~> Qid .
  eq binop('_==_) = '_eq_ .   eq binop('_!=_) = '_neq_ .
  eq binop('_<_) = '_lt_ .    eq binop('_<=_) = '_le_ .
  eq binop('_>_) = '_gt_ .    eq binop('_>=_) = '_ge_ .
  eq binop('_+_) = '_plus_ .     eq binop('_-_) = '_-_ .
  eq binop('_*_) = '_*_ .     eq binop('_and_) = '_and_ .
  eq binop('_/_) = '_quo_ .   eq binop('_%_) = '_rem_ .
  eq binop('_or_) = '_or_ .   eq binop('_`[_`]) = '_`[_`] .

  op isCall : Term -> Bool .
  eq isCall('_`(_`)['token[F], A]) = base(F) =/= 'Length and base(F) =/= 'IntAsDouble .
  eq isCall('_`(_`)[C, A]) = true [owise] .
  eq isCall('_`(`)['token[F]]) = base(F) =/= 'PI .
  eq isCall('_`(`)[C]) = true [owise] .
  eq isCall(T) = false [owise] .

  *** callables: identifier with Adjoint/Controlled functors
  op trCal : Term -> Term .
  eq trCal('token[F]) = qcon(base(F)) .
  eq trCal('Adjoint_[C]) = 'Adjoint_[trCal(C)] .
  eq trCal('Controlled_[C]) = 'Controlled_[trCal(C)] .

  op hx : Term Nat -> HRes .
  eq hx('token[T], N) = h(skipS, atom(T), N) .
  ceq hx(Q[A, B], N) = h(seq(P1, P2), Q'[E1, E2], N2)
   if Q' := binop(Q) /\ h(P1, E1, N1) := hx(A, N) /\ h(P2, E2, N2) := hx(B, N1) .
  ceq hx('-_[A], N) = h(P, '-_[E], N1) if h(P, E, N1) := hx(A, N) .
  ceq hx('not_[A], N) = h(P, 'not_[E], N1) if h(P, E, N1) := hx(A, N) .
  ceq hx('`[_`][A], N) = h(P, '`[_`][E], N1) if h(P, E, N1) := hxArgs(A, N) .
  ceq hx('_`(_`)['token[F], A], N) = h(P, 'Length[E], N1)
   if base(F) == 'Length /\ h(P, E, N1) := hx(A, N) .
  ceq hx('_`(_`)['token[F], A], N) = h(P, 'toD[E], N1)
   if base(F) == 'IntAsDouble /\ h(P, E, N1) := hx(A, N) .
  ceq hx('_`(`)['token[F]], N) = h(skipS, 'dbl[upTerm(0), upTerm(1)], N) if base(F) == 'PI .
  *** array slices
  ceq hx('_`[_`][A, '_.._.._[B, C, D]], N) = h(seq(P1, seq(P2, seq(P3, P))), 'sliceStep[E1, E2, E3, E], N4)
   if h(P1, E1, N1) := hx(A, N) /\ h(P2, E2, N2) := hx(B, N1) /\ h(P3, E3, N3) := hx(C, N2)
      /\ h(P, E, N4) := hx(D, N3) .
  ceq hx('`[_`,size`=_`][A, B], N) = h(seq(P1, P2), 'rep[E1, E2], N2)
   if h(P1, E1, N1) := hx(A, N) /\ h(P2, E2, N2) := hx(B, N1) .
  ceq hx('_`[_`][A, '_.._[B, C]], N) = h(seq(P1, seq(P2, P)), 'slice[E1, E2, E], N3)
   if h(P1, E1, N1) := hx(A, N) /\ h(P2, E2, N2) := hx(B, N1) /\ h(P, E, N3) := hx(C, N2) .
  ceq hx('_`[_`][A, '_...[B]], N) = h(seq(P1, P2), 'sliceFrom[E1, E2], N2)
   if h(P1, E1, N1) := hx(A, N) /\ h(P2, E2, N2) := hx(B, N1) .
  ceq hx('_`[_`][A, '..._[B]], N) = h(seq(P1, P2), 'sliceTo[E1, E2], N2)
   if h(P1, E1, N1) := hx(A, N) /\ h(P2, E2, N2) := hx(B, N1) .
  *** conditional expression
  ceq hx('_?_|_[A, B, C], N) = h(seq(P1, seq(P2, P)), 'cond[E1, E2, E], N3)
   if h(P1, E1, N1) := hx(A, N) /\ h(P2, E2, N2) := hx(B, N1) /\ h(P, E, N3) := hx(C, N2) .
  *** parentheses and tuples
  ceq hx('tuple`(_`)[A], N) = h(P, 'tuple[E], N1) if h(P, E, N1) := hxArgs(A, N) .
  eq hx('`(_`)[A], N) = hx(A, N) .
  eq hx('`[`].@Exp@, N) = h(skipS, '`[_`]['noE.ExpList], N) .
  *** a call inside an expression is moved to a temporary
  ceq hx(T, N) = h(seq(P, 'let_=_;[tmp(N1), C]), tmp(N1), s N1)
   if isCall(T) /\ h(P, C, N1) := trCall(T, N) .

  *** arguments: a single term or a '_`,_ list
  op hxArgs : Term Nat -> HRes .
  ceq hxArgs('_`,_[A, NeTL], N) = h(seq(P1, P2), '_`,_[E1, E2], N2)
   if h(P1, E1, N1) := hx(A, N) /\ h(P2, E2, N2) := hxArgs(tail('_`,_, A, NeTL), N1) .
  eq hxArgs(T, N) = hx(T, N) [owise] .

  *** the rest of an argument list, again as a term
  op tail : Qid Term NeTermList -> Term .
  eq tail(Q, A, B) = B .
  eq tail(Q, A, (B, NeTL)) = Q[B, NeTL] .

  *** call at the root: kept as a Call
  op trCall : Term Nat -> HRes .
  ceq trCall('_`(_`)[C, A], N) = h(P, '_`(_`)[trCal(C), E], N1)
   if h(P, E, N1) := hxArgs(A, N) .
  eq trCall('_`(`)[C], N) = h(skipS, '_`(`)[trCal(C)], N) .

  *** expression or call at the root of let/set/return
  op hTop : Term Nat -> HRes .
  ceq hTop(T, N) = trCall(T, N) if isCall(T) .
  eq hTop(T, N) = hx(T, N) [owise] .

  *** ---------- statements ----------
  sort SRes .
  op sr : Term Nat -> SRes [ctor] .

  op trSs : Term Nat -> SRes .
  ceq trSs('__[A, NeTL], N) = sr(seq(P1, P2), N2)
   if sr(P1, N1) := trS(A, N) /\ sr(P2, N2) := trSs(tail('__, A, NeTL), N1) .
  eq trSs(T, N) = trS(T, N) [owise] .

  op trB : Term Nat -> SRes .
  eq trB('`{`}.@Block@, N) = sr(skipS, N) .
  *** a block ending in an expression returns it (implicit return)
  ceq trB('`{_`}[A], N) = trS('return_;[A], N) if isExp(A) .
  eq trB('`{_`}[Ss], N) = trSs(Ss, N) [owise] .
  ceq trB('`{__`}[Ss, A], N) = sr(seq(P1, P2), N2)
   if sr(P1, N1) := trSs(Ss, N) /\ sr(P2, N2) := trS('return_;[A], N1) .

  op isExp : Term -> Bool .
  eq isExp(Q[TL]) = not (Q in ('use_=_; 'let_=_; 'mutable_=_; 'set_=_; 'set_+=_; 'set_-=_;
                               'set_*=_; '_=_; '_+=_; '_-=_; '_*=_; 'fail_;
                               '_; 'return_; 'if__ 'if___ 'for_in__ 'while__ 'repeat_until_;
                               'repeat_until_fixup_ 'within_apply_ '__)) .
  eq isExp(T) = true [owise] .
  op _in_ : Qid QidList -> Bool .
  eq Q in (Q' QL:QidList) = Q == Q' or Q in QL:QidList .
  eq Q in nil = false .

  op trS : Term Nat -> SRes .
  *** use
  eq trS('use_=_;['token[X], 'Qubit`(`).@Alloc@], N) =
     sr('use_=_;[qc(X), 'Qubit`(`).Alloc], N) .
  ceq trS('use_=_;['token[X], 'Qubit`[_`][A]], N) =
      sr(seq(P, 'use_=_;[qc(X), 'Qubit`[_`][E]]), N1)
   if h(P, E, N1) := hx(A, N) .
  *** use of a tuple of qubits
  eq trS('use_=_;['tuple`(_`)[A], 'tuple`(_`)[B]], N) = sr(uses(A, B), N) .
  *** fail: a call to an undefined operation, which gets stuck
  eq trS('fail_;[A], N) = sr('_;['_`(`)[qcon('fail)]], N) .
  *** assignments without set
  eq trS('_=_;[X, A], N) = trS('set_=_;[X, A], N) .
  eq trS('_+=_;[X, A], N) = trS('set_+=_;[X, A], N) .
  eq trS('_-=_;[X, A], N) = trS('set_-=_;[X, A], N) .
  eq trS('_*=_;[X, A], N) = trS('set_*=_;[X, A], N) .
  ceq trS('set_*=_;['token[X], A], N) =
      sr(seq(P, 'set_=_;[Q, '_*_[Q, E]]), N1)
   if Q := qc(X) /\ h(P, E, N1) := hx(A, N) .
  *** tuple patterns: let (a, b) = e;  ->  let $t = e; let a = proj($t, 0); ...
  ceq trS(Q['tuple`(_`)[A], B], N) = sr(seq(P, seq(Q[tmp(N1), E], projs(Q, A, tmp(N1), 0))), s N1)
   if Q == 'let_=_; or Q == 'mutable_=_; /\ h(P, E, N1) := hTop(B, N) .
  ceq trS('for_in__['tuple`(_`)[A], B, Blk], N) =
      sr(seq(P, 'for_in_`{_`}[tmp(N1), E, seq(projs('let_=_;, A, tmp(N1), 0), Ss)]), N2)
   if h(P, E, N1) := hx(B, N) /\ sr(Ss, N2) := trB(Blk, s N1) .
  *** let, mutable, set
  ceq trS(Q['token[X], A], N) = sr(seq(P, Q[qc(X), E]), N1)
   if Q == 'let_=_; or Q == 'mutable_=_; or Q == 'set_=_; or Q == 'set_+=_;
   /\ h(P, E, N1) := hTop(A, N) .
  ceq trS('set_-=_;['token[X], A], N) =
      sr(seq(P, 'set_=_;[Q, '_-_[Q, E]]), N1)
   if Q := qc(X) /\ h(P, E, N1) := hx(A, N) .
  *** call as a statement, and return
  ceq trS('_;['_`(_`)['token[F], A]], N) = sr(skipS, N) if ignored(base(F)) .
  *** Fact(c, msg) is an assertion on c; the message is dropped
  ceq trS('_;['_`(_`)['token[F], '_`,_[A, B]]], N) = sr(seq(P, 'assert_;[E]), N1)
   if base(F) == 'Fact /\ h(P, E, N1) := hx(A, N) .
  ceq trS('_;['_`(`)['token[F]]], N) = sr(skipS, N) if ignored(base(F)) .
  ceq trS('_;['_`(_`)['token[F], '_`,_['token[X], A]]], N) =
      sr(seq(P, 'for_in_`{_`}[tmp(N1), E, '_;['_`(_`)[qcon(base(X)), tmp(N1)]]]), s N1)
   if applyEach(base(F)) /\ h(P, E, N1) := hx(A, N) .
  ceq trS('_;[A], N) = sr(seq(P, '_;[C]), N1) if h(P, C, N1) := trCall(A, N) [owise] .
  ceq trS('return_;[A], N) = sr(seq(P, 'return_;[E]), N1) if h(P, E, N1) := hTop(A, N) .
  *** if / elif / else
  ceq trS('if__[A, Blk], N) = sr(seq(P, 'if_`{_`}else`{_`}[E, Ss, skipS]), N2)
   if h(P, E, N1) := hx(A, N) /\ sr(Ss, N2) := trB(Blk, N1) .
  ceq trS('if___[A, Blk, El], N) = sr(seq(P, 'if_`{_`}else`{_`}[E, Ss, T]), N3)
   if h(P, E, N1) := hx(A, N) /\ sr(Ss, N2) := trB(Blk, N1) /\ sr(T, N3) := trElse(El, N2) .
  *** for over a range or over an array
  ceq trS('for_in__['token[X], '_.._[A, B], Blk], N) =
      sr(seq(seq(P1, P2), 'for_in_.._`{_`}[qc(X), E1, E2, Ss]), N3)
   if h(P1, E1, N1) := hx(A, N) /\ h(P2, E2, N2) := hx(B, N1) /\ sr(Ss, N3) := trB(Blk, N2) .
  ceq trS('for_in__['token[X], A, Blk], N) =
      sr(seq(P, 'for_in_`{_`}[qc(X), E, Ss]), N2)
   if h(P, E, N1) := hx(A, N) /\ sr(Ss, N2) := trB(Blk, N1) [owise] .
  *** while: condition without calls
  ceq trS('while__[A, Blk], N) = sr('while_`{_`}[E, Ss], N2)
   if h('skip.Stmts, E, N1) := hx(A, N) /\ sr(Ss, N2) := trB(Blk, N1) .
  *** repeat-until(-fixup): the prologue of the condition at the end of the body
  ceq trS('repeat_until_;[Blk, A], N) =
      sr('repeat`{_`}until_fixup`{_`}[seq(Ss, P), E, skipS], N2)
   if sr(Ss, N1) := trB(Blk, N) /\ h(P, E, N2) := hx(A, N1) .
  ceq trS('repeat_until_fixup_[Blk, A, T], N) =
      sr('repeat`{_`}until_fixup`{_`}[seq(Ss, P), E, C], N3)
   if sr(Ss, N1) := trB(Blk, N) /\ h(P, E, N2) := hx(A, N1) /\ sr(C, N3) := trB(T, N2) .

  *** within / apply
  ceq trS('within_apply_[Blk, T], N) = sr('within`{_`}apply`{_`}[Ss, C], N2)
   if sr(Ss, N1) := trB(Blk, N) /\ sr(C, N2) := trB(T, N1) .

  op projs : Qid Term Term Nat -> Term .
  eq projs(Q, '_`,_['token[X], NeTL], T, N) =
     seq(projs(Q, 'token[X], T, N), projs(Q, tail('_`,_, 'token[X], NeTL), T, s N)) .
  eq projs(Q, 'token[X], T, N) = Q[qc(X), 'proj[T, upTerm(N)]] .

  op uses : Term Term -> Term .
  eq uses('_`,_['token[X], NeTL], '_`,_[A, TL]) =
     seq(uses('token[X], A), uses(tail('_`,_, 'token[X], NeTL), tail('_`,_, A, TL))) .
  eq uses('token[X], 'Qubit`(`).@Alloc@) = 'use_=_;[qc(X), 'Qubit`(`).Alloc] .
  eq uses('token[X], 'Qubit`[_`][A]) = 'use_=_;[qc(X), 'Qubit`[_`][atomExp(A)]] .
  op atomExp : Term -> Term .
  ceq atomExp(A) = E if h('skip.Stmts, E, N) := hx(A, 0) .

  op trElse : Term Nat -> SRes .
  eq trElse('else_[Blk], N) = trB(Blk, N) .
  eq trElse('elif__[A, Blk], N) = trS('if__[A, Blk], N) .
  eq trElse('elif___[A, Blk, El], N) = trS('if___[A, Blk, El], N) .

  *** ---------- types, parameters, declarations ----------
  op trTy : Term -> Term .
  eq trTy('_`[`][T]) = '_`[`][trTy(T)] .
  eq trTy('tuple`(_`)[A]) = trTy(A) .
  eq trTy('_`,_[A, NeTL]) = 'tupleT[trTy(A), trTy(tail('_`,_, A, NeTL))] .
  eq trTy('_=>_[A, B]) = 'OpType.Type .
  eq trTy('_->_[A, B]) = 'OpType.Type .
  eq trTy('_=>_is_[A, B, C]) = 'OpType.Type .
  eq trTy(Cn:Constant) = qid(string(getName(Cn:Constant)) + ".Type") .

  op trPs : Term -> Term .
  eq trPs('_:_['token[X], Ty]) = '_:_[qc(X), trTy(Ty)] .
  eq trPs('tuple`(_`)[A]) = 'ptup[trPs(A)] .
  eq trPs('_`,_[A, NeTL]) = '_`,_[trPs(A), trPs(tail('_`,_, A, NeTL))] .

  op body : Term -> Term .
  ceq body(Blk) = Ss if sr(Ss, N) := trB(Blk, 0) .

  *** operation bodies given as a list of specializations
  op isSp : Term -> Bool .
  eq isSp('body`(...`)_[T]) = true .
  eq isSp('body_;[T]) = true .
  eq isSp('adjoint`(...`)_[T]) = true .
  eq isSp('adjoint_;[T]) = true .
  eq isSp('controlled`(_`,...`)_[T, T']) = true .
  eq isSp('controlled_;[T]) = true .
  eq isSp('controlled_`(_`,...`)_[T, T', E]) = true .
  eq isSp('controlled__;[T, T']) = true .
  eq isSp('__[T, NeTL]) = isSp(T) .
  eq isSp(T) = false [owise] .

  *** the body block among the specializations
  op spBody : Term -> Term .
  eq spBody('body`(...`)_[Blk]) = Blk .
  eq spBody('__[A, NeTL]) =
     if spBody(A) == '`{`}.@Block@ then spBody(tail('__, A, NeTL)) else spBody(A) fi .
  eq spBody(T) = '`{`}.@Block@ [owise] .

  *** the other specializations, as declarations
  op trSp : Term Term -> Term .
  eq trSp(F, 'adjoint`(...`)_[Blk]) = 'adjBody[F, body(Blk)] .
  eq trSp(F, 'adjoint_;['self.@Gen@]) = 'adjSelf[F] .
  eq trSp(F, 'controlled`(_`,...`)_['token[C], Blk]) = 'ctlBody[F, qc(C), body(Blk)] .
  eq trSp(F, 'controlled_`(_`,...`)_[A, 'token[C], Blk]) = 'ctlAdjBody[F, qc(C), body(Blk)] .
  eq trSp(F, 'controlled__;[A, 'self.@Gen@]) = 'ctlAdjSelf[F] .
  eq trSp(F, 'controlled__;[A, 'invert.@Gen@]) = 'ctlAdjInvert[F] .
  eq trSp(F, 'controlled__;[A, 'distribute.@Gen@]) = 'ctlAdjDistribute[F] .
  eq trSp(F, '__[A, NeTL]) = '__[trSp(F, A), trSp(F, tail('__, A, NeTL))] .
  eq trSp(F, T) = 'noD.Decls [owise] .

  op trD : Term -> Term .
  ceq trD('operation_`(_`):__['token[F], A, Ty, '`{_`}[Sp]]) =
     '__[trD('operation_`(_`):__['token[F], A, Ty, spBody(Sp)]), trSp(qc(F), Sp)]
   if isSp(Sp) .
  ceq trD('operation_`(`):__['token[F], Ty, '`{_`}[Sp]]) =
     '__[trD('operation_`(`):__['token[F], Ty, spBody(Sp)]), trSp(qc(F), Sp)]
   if isSp(Sp) .
  eq trD('operation_`(_`):__['token[F], A, Ty, Blk]) =
     'operation_`(_`):_`{_`}[qc(F), trPs(A), trTy(Ty), body(Blk)] .
  eq trD('operation_`(`):__['token[F], Ty, Blk]) =
     'operation_`(_`):_`{_`}[qc(F), 'noP.Params, trTy(Ty), body(Blk)] .
  eq trD('operation_`(_`):_is__[F, A, Ty, C, Blk]) = trD('operation_`(_`):__[F, A, Ty, Blk]) .
  eq trD('operation_`(`):_is__[F, Ty, C, Blk]) = trD('operation_`(`):__[F, Ty, Blk]) .
  eq trD('function_`(_`):__[F, A, Ty, Blk]) = trD('operation_`(_`):__[F, A, Ty, Blk]) .
  eq trD('function_`(`):__[F, Ty, Blk]) = trD('operation_`(`):__[F, Ty, Blk]) .
  eq trD('__['@EntryPoint`(`).@Attr@, T]) = trD(T) .
  eq trD('import_;[T]) = 'noD.Decls .
  eq trD('open_;[T]) = 'noD.Decls .
  eq trD('namespace_`{_`}[X, T]) = trD(T) .
  eq trD('__[A, NeTL]) = '__[trD(A), trD(tail('__, A, NeTL))] .

  *** whole program: term of sort Decls in QSHARP-SYNTAX
  op trProgram : Term -> Term .
  eq trProgram(T) = trD(T) .
endfm
