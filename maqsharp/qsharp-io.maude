*** MaQ#: interactive tool for Q# in Maude.
***
***   maude -allow-files qsharp-io.maude
***
*** Commands:
***   open file.qs                 loads and translates a Q# program
***   show                         shows the program translated into QSHARP-SYNTAX
***   run Op                       runs Op() with probabilities (at most 10 solutions)
***   runnp Op                     runs Op() without probabilities (finite graph with loops)
***   run Op (args) in state       starts from the given arguments and quantum state, e.g.
***                                run Teleport (qb(0), qb(1)) in (q[0]: a . |0> + b . |1>) (q[1]: |0>)
***   check Op ensures cond        checks cond in ALL final states (mode without
***   check Op (args) in state ensures cond      probabilities); cond may use
***                                QS:Qubit (final state) and RES:Value (result)
***   dist Op                      EXACT distribution of results: adds up the
***   dist Op (args) in state      probabilities of all paths (up to 200 steps)
***   dist Op depth N              same, but exploring paths of up to N steps
***   mc Op satisfies F            LTL model checking of F (mode without probabilities);
***   mc Op (args) in state satisfies F     propositions: ended, returns(V),
***                                qubit(N, V), qubitPh(N, V), entangled(N), liveLE(K)
***   states Op                    number of reachable states (mode without probabilities)
***   module M                     module for args/state/cond (QSHARP-PROPS by default);
***                                M must be loaded beforehand and extend QSHARP-PROPS
***   q | quit
***
*** Structure taken from MUnit (https://github.com/ariesco/MUnit).

load file.maude
sload qsharp-props.maude
sload qsharp-mc.maude
load frontend/qsharp-lexer.maude
load frontend/qsharp-surface.maude
load frontend/qsharp-translate.maude
load frontend/qsharp-prelude.maude

fmod MAYBE{X :: TRIV} is
  sort Maybe{X} .
  subsort X$Elt < Maybe{X} .
  op maybe : -> Maybe{X} [ctor] .
endfm

view Term from TRIV to META-TERM is
  sort Elt to Term .
endv

fmod QSHARP-PROCESSING is
  pr MAYBE{Term} .
  pr QSHARP-TRANSLATE .
  pr QSHARP-META-GRAMMARS .
  pr QSHARP-LEXER .
  pr LEXICAL .
  pr QSHARP-PRELUDE .

  vars T T' P C St Ar V Pr Qs A1 Q1 C1 : Term .
  var MP : Maybe{Term} . var Ty' : Type . var MC : Module .
  var TL : TermList . var NeTL : NeTermList .
  var M : Module . vars Q F : Qid . vars N I MAX : Nat .
  var S : Substitution . var QIL : QidList . var Ty : Type .
  var R : ResultTriple . var V' : Variable .

  op popts : -> PrintOptionSet .
  eq popts = mixfix number rat .

  op pp : Module Term -> String .
  eq pp(M, T) = printTokens(metaPrettyPrint(M, T, popts)) .

  op val : Substitution Variable -> Term .
  eq val(V' <- T ; S, V') = T .

  *** loading: returns the translated and reduced program, or an error message
  sort LoadResult .
  op loaded : Term -> LoadResult [ctor] .
  op loadError : String -> LoadResult [ctor] .

  op load : Module String -> LoadResult .
  ceq load(M, St:String) = loadTr(M, T)
   if {T, Ty} := metaParse(QSHARP-GRAMMAR, tokenize(lex(St:String)), '@Decls@) .
  ceq load(M, St:String) =
      loadError("syntax error at token " + string(N, 10) + ": "
                + printTokens(nthTok(tokenize(lex(St:String)), N)))
   if noParse(N) := metaParse(QSHARP-GRAMMAR, tokenize(lex(St:String)), '@Decls@) .
  eq load(M, St:String) = loadError("ambiguous input") [owise] .

  op loadTr : Module Term -> LoadResult .
  ceq loadTr(M, T) = loaded(T')
   if P := trProgram(T) /\ {T', Ty} := metaReduce(M, P) /\ sortLeq(M, Ty, 'Decls) .
  eq loadTr(M, T) =
     loadError("construct not supported in this subset, e.g. a call "
               + "in the condition of a while") [owise] .

  op nthTok : QidList Nat -> QidList .
  eq nthTok(Q QIL, 0) = Q .
  eq nthTok(Q QIL, s N) = nthTok(QIL, N) .
  eq nthTok(nil, N) = nil .

  *** names of the operations of a program
  op opNames : Term -> String .
  eq opNames(T) = printTokens(opNamesL(T)) .
  op opNamesL : Term -> QidList .
  eq opNamesL('__[T, NeTL]) = opNamesL(T) opNamesL(tail('__, T, NeTL)) .
  eq opNamesL('operation_`(_`):_`{_`}[T, TL]) =
     if downTerm(T, 'err) in preludeOps then nil else downTerm(T, 'err) fi .
  eq opNamesL(T) = nil [owise] .

  --- show: user operations only, one per paragraph
  op showOps : Module Term -> String .
  eq showOps(M, '__[T, NeTL]) = showOps(M, T) + showOps(M, tail('__, T, NeTL)) .
  eq showOps(M, T) = if isPrelude(T) then "" else pp(M, T) + "\n" fi [owise] .
  op isPrelude : Term -> Bool .
  eq isPrelude('operation_`(_`):_`{_`}[T, TL]) = downTerm(T, 'err) in preludeOps .
  eq isPrelude(T) = false [owise] .

  *** command bubbles: list of qids -> term in module M
  op bubble : Module Term Type ~> Term .
  ceq bubble(M, 'bubble[T], Ty) = T'
   if QIL := downTerm(T, (nil).QidList) /\ {T', Ty'} := metaParse(M, QIL, Ty) .

  *** initial terms
  op initRun : Term Qid -> Term .
  eq initRun(P, F) = 'run[P, qcon(F)] .
  op initRunNP : Term Qid -> Term .
  eq initRunNP(P, F) = 'runNP[P, qcon(F)] .
  op initWith : Qid Term Qid Term Term -> Term .
  eq initWith(Q, P, F, Ar, Qs) = Q[P, qcon(F), Ar, Qs, 'nextFree[Qs]] .

  *** final state pattern
  op finalPat : -> Term .
  eq finalPat = '`{_`}['__['qstate:_['QS:Qubit], 'result:_['RES:Value],
                           'prob:_['PR:Prob], 'isEnd:_['true.Bool], 'R:Comps]] .

  *** enumerate final solutions
  op solutions : Module Term Bool Nat Nat -> String .
  eq solutions(M, T, B:Bool, I, MAX) =
     if I == MAX then "  (only the first " + string(MAX, 10) + " are shown)\n"
     else $solutions(M, T, B:Bool, I, MAX,
                     metaSearch(M, T, finalPat, nil, '!, unbounded, I)) fi .
  op $solutions : Module Term Bool Nat Nat ResultTriple? -> String .
  eq $solutions(M, T, B:Bool, 0, MAX, failure) =
     "  no final states" + stuckAt(M, metaSearch(M, T, stuckPat, nil, '!, unbounded, 0)) + "\n" .

  *** first statement of a stuck (terminal, non-final) state
  op stuckPat : -> Term .
  eq stuckPat = '`{_`}['__['k:_['K:Stmts], 'isEnd:_['false.Bool], 'R:Comps]] .
  op stuckAt : Module ResultTriple? -> String .
  eq stuckAt(M, failure) = "" .
  eq stuckAt(M, {T', Ty, S}) = "; stuck at: " + pp(M, firstStmt(val(S, 'K:Stmts))) .
  op firstStmt : Term -> Term .
  eq firstStmt('__[T, NeTL]) = T .
  eq firstStmt(T) = T [owise] .
  eq $solutions(M, T, B:Bool, s I, MAX, failure) = "" .
  eq $solutions(M, T, B:Bool, I, MAX, {T', Ty, S}) =
     "  result: " + pp(M, val(S, 'RES:Value))
     + (if B:Bool then "   prob: " + pp(M, val(S, 'PR:Prob)) else "" fi)
     + "   qubits: " + pp(M, val(S, 'QS:Qubit)) + "\n"
     + solutions(M, T, B:Bool, s I, MAX) .

  *** ---------- command execution ----------
  op isExec : Term -> Bool .
  eq isExec('show.@Command@) = true .
  eq isExec('run_[T]) = true .
  eq isExec('runnp_[T]) = true .
  eq isExec('run_`(_`)in_[T, Ar, Qs]) = true .
  eq isExec('runnp_`(_`)in_[T, Ar, Qs]) = true .
  eq isExec('check_ensures_[T, C]) = true .
  eq isExec('dist_[T]) = true .
  eq isExec('dist_depth_[T, C]) = true .
  eq isExec('states_[T]) = true .
  eq isExec('states_`(_`)in_[T, Ar, Qs]) = true .
  eq isExec('dist_`(_`)in_depth_[T, Ar, Qs, C]) = true .
  eq isExec('mc_satisfies_[T, C]) = true .
  eq isExec('mc_`(_`)in_satisfies_[T, Ar, Qs, C]) = true .
  eq isExec('dist_`(_`)in_[T, Ar, Qs]) = true .
  eq isExec('check_`(_`)in_ensures_[T, Ar, Qs, C]) = true .
  eq isExec(T) = false [owise] .

  op exec : Term Maybe{Term} Module -> String .
  eq exec(T, maybe, M) = err("no program loaded (use open)") .
  eq exec('show.@Command@, P, M) = ok(showOps(M, P)) .
  eq exec('run_['token[T]], P, M) = ok(solutions(M, initRun(P, downTerm(T, 'err)), true, 0, 10)) .
  eq exec('runnp_['token[T]], P, M) = ok(solutions(M, initRunNP(P, downTerm(T, 'err)), false, 0, 10)) .
  ceq exec('run_`(_`)in_['token[T], Ar, Qs], P, M) =
      ok(solutions(M, initWith('runWith, P, downTerm(T, 'err), A1, Q1), true, 0, 10))
   if A1 := bubble(M, Ar, 'ExpList) /\ Q1 := bubble(M, Qs, 'Qubit) .
  ceq exec('runnp_`(_`)in_['token[T], Ar, Qs], P, M) =
      ok(solutions(M, initWith('runWithNP, P, downTerm(T, 'err), A1, Q1), false, 0, 10))
   if A1 := bubble(M, Ar, 'ExpList) /\ Q1 := bubble(M, Qs, 'Qubit) .
  ceq exec('check_ensures_['token[T], C], P, M) = ok(check(M, initRunNP(P, downTerm(T, 'err)), C1))
   if C1 := bubble(M, C, 'Bool) .
  ceq exec('check_`(_`)in_ensures_['token[T], Ar, Qs, C], P, M) =
      ok(check(M, initWith('runWithNP, P, downTerm(T, 'err), A1, Q1), C1))
   if A1 := bubble(M, Ar, 'ExpList) /\ Q1 := bubble(M, Qs, 'Qubit) /\ C1 := bubble(M, C, 'Bool) .
  ceq exec('mc_satisfies_['token[T], C], P, M) = ok(ltl(MC, initRunNP(P, downTerm(T, 'err)), C1))
   if MC := mcModule(M) /\ C1 := bubble(MC, C, 'Formula) .
  ceq exec('mc_`(_`)in_satisfies_['token[T], Ar, Qs, C], P, M) =
      ok(ltl(MC, initWith('runWithNP, P, downTerm(T, 'err), A1, Q1), C1))
   if MC := mcModule(M) /\ A1 := bubble(MC, Ar, 'ExpList) /\ Q1 := bubble(MC, Qs, 'Qubit)
   /\ C1 := bubble(MC, C, 'Formula) .
  eq exec('states_['token[T]], P, M) =
     ok("  reachable states (without probabilities): "
        + string(countStates(M, initRunNP(P, downTerm(T, 'err)), 0), 10) + "\n") .
  eq exec('dist_['token[T]], P, M) = ok(dist(M, initRun(P, downTerm(T, 'err)), 200)) .
  ceq exec('dist_depth_['token[T], 'token[DT:Term]], P, M) =
      ok(dist(M, initRun(P, downTerm(T, 'err)), N))
   if N := rat(string(downTerm(DT:Term, 'err)), 10) .
  ceq exec('dist_`(_`)in_['token[T], Ar, Qs], P, M) =
      ok(dist(M, initWith('runWith, P, downTerm(T, 'err), A1, Q1), 200))
   if A1 := bubble(M, Ar, 'ExpList) /\ Q1 := bubble(M, Qs, 'Qubit) .
  ceq exec('states_`(_`)in_['token[T], Ar, Qs], P, M) =
      ok("  reachable states (without probabilities): "
         + string(countStates(M, initWith('runWithNP, P, downTerm(T, 'err), A1, Q1), 0), 10) + "\n")
   if A1 := bubble(M, Ar, 'ExpList) /\ Q1 := bubble(M, Qs, 'Qubit) .
  ceq exec('dist_`(_`)in_depth_['token[T], Ar, Qs, 'token[DT:Term]], P, M) =
      ok(dist(M, initWith('runWith, P, downTerm(T, 'err), A1, Q1), N))
   if A1 := bubble(M, Ar, 'ExpList) /\ Q1 := bubble(M, Qs, 'Qubit)
   /\ N := rat(string(downTerm(DT:Term, 'err)), 10) .
  eq exec(T, MP, M) = err("could not parse the arguments, the state or the condition") [owise] .

  op err : String -> String .
  eq err(St:String) = "\n" + printTokens('\! '\r) + "Error: " + printTokens('\o) + St:String + "\n\n" .
  op ok : String -> String .
  eq ok(St:String) = "\n" + St:String + "\n" .

  *** ---------- exact distribution of results ----------
  *** The execution TREE is traversed, not the graph: with metaApply rule by
  *** rule, two branches reaching the same configuration are not merged.
  *** The mode with probabilities must be used, and each leaf adds its prob: to
  *** the result it returns. Exploration stops after MAX rewrite steps and the
  *** unexplored mass (RUS loops) and the mass in stuck states are reported.
  var RS : RuleSet . var AtS : AttrSet . var Cd : Condition . var L : Qid .
  var TL' : TermList . var D : Dist . vars Rs Stk : Term .

  op ruleLabels : RuleSet -> QidList .
  eq ruleLabels(none) = nil .
  eq ruleLabels((rl T => T' [label(L) AtS] .) RS) = L ruleLabels(RS) .
  eq ruleLabels((crl T => T' if Cd [label(L) AtS] .) RS) = L ruleLabels(RS) .

  op succs : Module QidList Term -> TermList .
  eq succs(M, nil, T) = empty .
  eq succs(M, L QIL, T) = succsL(M, L, T, 0), succs(M, QIL, T) .
  op succsL : Module Qid Term Nat -> TermList .
  eq succsL(M, L, T, I) = $succsL(M, L, T, I, metaApply(M, T, L, none, I)) .
  op $succsL : Module Qid Term Nat ResultTriple? -> TermList .
  eq $succsL(M, L, T, I, failure) = empty .
  eq $succsL(M, L, T, I, {T', Ty, S}) = T', succsL(M, L, T, s I) .

  *** component of a configuration {(c1) (c2) ...}
  op comp : Qid Term ~> Term .
  eq comp(Q, '`{_`}['__[TL]]) = $comp(Q, TL) .
  op $comp : Qid TermList ~> Term .
  eq $comp(Q, (Q[T], TL)) = T .
  eq $comp(Q, (T, TL)) = $comp(Q, TL) [owise] .

  sort Dist .
  op noDist : -> Dist [ctor] .
  op d : Term Term -> Dist [ctor] .
  op _&&_ : Dist Dist -> Dist [ctor assoc comm id: noDist] .

  op plus : Module Term Term -> Term .
  eq plus(M, T, T') = getTerm(metaReduce(M, '_.+_[T, T'])) .
  op addD : Module Dist Term Term -> Dist .
  eq addD(M, d(V, Pr) && D, V, T') = d(V, plus(M, Pr, T')) && D .
  eq addD(M, D, V, T') = d(V, T') && D [owise] .

  *** work stack: configuration and number of steps taken
  sorts WItem WList .
  subsort WItem < WList .
  op w : Term Nat -> WItem [ctor] .
  op nilW : -> WList [ctor] .
  op _::_ : WList WList -> WList [ctor assoc id: nilW] .
  op push : TermList Nat WList -> WList .
  eq push(empty, N, W:WList) = W:WList .
  eq push((T, TL), N, W:WList) = w(T, N) :: push(TL, N, W:WList) .

  sort DRes .
  op res : Dist Term Term -> DRes [ctor] .   *** distribution, unexplored, stuck

  op explore : Module QidList WList Nat Dist Term Term -> DRes .
  eq explore(M, QIL, nilW, MAX, D, Rs, Stk) = res(D, Rs, Stk) .
  ceq explore(M, QIL, w(T, N) :: W:WList, MAX, D, Rs, Stk)
    = explore(M, QIL, W:WList, MAX, addD(M, D, comp('result:_, T), comp('prob:_, T)), Rs, Stk)
   if comp('isEnd:_, T) == 'true.Bool .
  ceq explore(M, QIL, w(T, N) :: W:WList, MAX, D, Rs, Stk)
    = explore(M, QIL, W:WList, MAX, D, plus(M, Rs, comp('prob:_, T)), Stk)
   if comp('isEnd:_, T) =/= 'true.Bool /\ N >= MAX .
  ceq explore(M, QIL, w(T, N) :: W:WList, MAX, D, Rs, Stk)
    = explore(M, QIL, push(TL', s N, W:WList), MAX, D, Rs, Stk)
   if comp('isEnd:_, T) =/= 'true.Bool /\ N < MAX /\ TL' := succs(M, QIL, T) /\ TL' =/= empty .
  eq explore(M, QIL, w(T, N) :: W:WList, MAX, D, Rs, Stk)
    = explore(M, QIL, W:WList, MAX, D, Rs, plus(M, Stk, comp('prob:_, T))) [owise] .

  op dist : Module Term Nat -> String .
  eq dist(M, T, MAX) =
     showDist(M, explore(M, ruleLabels(getRls(upModule(getName(M), true))), w(getTerm(metaReduce(M, T)), 0),
                         MAX, noDist, '0.Zero, '0.Zero), MAX) .

  op showDist : Module DRes Nat -> String .
  eq showDist(M, res(D, Rs, Stk), MAX) =
     showD(M, D)
     + (if Rs == '0.Zero then ""
        else "  unexplored (more than " + string(MAX, 10) + " steps): " + pp(M, Rs) + "\n" fi)
     + (if Stk == '0.Zero then ""
        else "  in stuck states (error): " + pp(M, Stk) + "\n" fi) .
  op showD : Module Dist -> String .
  eq showD(M, noDist) = "" .
  eq showD(M, d(V, Pr) && D) = "  result: " + pp(M, V) + "   prob: " + pp(M, Pr) + "\n" + showD(M, D) .

  *** ---------- number of reachable states ----------
  op countStates : Module Term Nat -> Nat .
  eq countStates(M, T, N) =
     if metaSearch(M, T, 'C:Config, nil, '*, unbounded, N) == failure then N
     else countStates(M, T, s N) fi .

  *** ---------- LTL model checking ----------
  *** The working module is joined at the metalevel with QSHARP-MC (stutter and
  *** propositions) and modelCheck is reduced in the mode without probabilities.
  op mcModule : Module -> Module .
  eq mcModule(M) = (mod 'QSHARP-LTL-TMP is
                      (including getName(M) .) (including 'QSHARP-MC .)
                      sorts none . none none none none none endm) .

  op ltl : Module Term Term -> String .
  eq ltl(M, T, C) = $ltl(M, getTerm(metaReduce(M, 'modelCheck[T, C]))) .
  op $ltl : Module Term -> String .
  eq $ltl(M, 'true.Bool) = "  holds\n" .
  eq $ltl(M, 'counterexample[T, T']) =
     "  does NOT hold. Counterexample (applied rules):\n    path:  "
     + printTokens(trLabels(T)) + "\n    cycle: " + printTokens(trLabels(T')) + "\n" .
  eq $ltl(M, T) = "  unexpected result: " + pp(M, T) + "\n" [owise] .

  *** labels of the transitions of a counterexample
  op trLabels : Term -> QidList .
  op trLabelsL : TermList -> QidList .
  eq trLabels('`{_`,_`}[T, T']) = ruleName(T') .
  eq trLabels('nil.TransitionList) = nil .
  eq trLabels(Q[TL]) = trLabelsL(TL) [owise] .
  eq trLabels(T) = nil [owise] .
  eq trLabelsL(empty) = nil .
  eq trLabelsL((T, TL)) = trLabels(T) trLabelsL(TL) .
  op ruleName : Term -> QidList .
  eq ruleName(Cn:Constant) =
     if getType(Cn:Constant) == 'Qid then downTerm(Cn:Constant, 'err) else getName(Cn:Constant) fi .

  *** lines of scripts: blank lines and comments (starting with --- or #) are skipped
  var LN : String . var QQ : Qid . var QL : QidList .
  op firstLine : String -> String .
  eq firstLine(LN) = if find(LN, "\n", 0) == notFound then LN else substr(LN, 0, find(LN, "\n", 0)) fi .
  op restLines : String -> String .
  eq restLines(LN) = if find(LN, "\n", 0) == notFound then "" else substr(LN, s find(LN, "\n", 0), length(LN)) fi .
  op skipLines : String -> String .
  eq skipLines(LN) = if LN =/= "" and-then skipLine(tokenize(firstLine(LN))) then skipLines(restLines(LN)) else LN fi .
  op skipLine : QidList -> Bool .
  eq skipLine(nil) = true .
  eq skipLine(QQ QL) = substr(string(QQ), 0, 3) == "---" or substr(string(QQ), 0, 1) == "#" .

  *** check a condition in all final states
  *** a final state is a counterexample unless the condition reduces to true,
  *** so a condition that cannot be evaluated is never reported as holding
  op check : Module Term Term -> String .
  eq check(M, T, C) =
     $check(M, metaSearch(M, T, finalPat, '_=/=_[C, 'true.Bool] = 'true.Bool, '!, unbounded, 0)) .
  op $check : Module ResultTriple? -> String .
  eq $check(M, failure) = "  holds in all final states\n" .
  eq $check(M, {T', Ty, S}) =
     "  does NOT hold. Counterexample:\n    result: " + pp(M, val(S, 'RES:Value))
     + "\n    qubits: " + pp(M, val(S, 'QS:Qubit)) + "\n" .
endfm

mod QSHARP-IO is
  pr QSHARP-PROCESSING .
  pr MAYBE{Term} .
  inc STD-STREAM .
  inc FILE .

  var AtS : AttributeSet . vars S D TXT St : String .
  var FHIn : Oid . var Ty : Type . vars T T' P Ar Qs C : Term .
  var MOD : Qid . var M : Module . var MP : Maybe{Term} . var Q : Qid .
  var Reason : String .

  op input:_ : Maybe{Term} -> Attribute [ctor] .
  op state:_ : State -> Attribute [ctor] .
  op data:_ : String -> Attribute [ctor gather (&)] .
  op prog:_ : Maybe{Term} -> Attribute [ctor] .
  op mod:_ : Qid -> Attribute [ctor] .
  *** commands still to be run from scripts loaded with load
  op script:_ : String -> Attribute [ctor gather (&)] .

  sort State .
  ops idle waiting reading processing write&wait write&end finished : -> State [ctor] .
  ops readingScript echoing : -> State [ctor] .

  op qsharp : -> Oid [ctor] .
  op QSharp : -> Cid [ctor] .

  op banner : -> String .
  eq banner = "\n\t\t MaQ#: Q# in Maude\n\t\t Executable semantics of a subset of Q#\n\n" .
  *** ---------- reading commands ----------
  *** commands come from the pending scripts, if any, and otherwise from stdin
  crl [prompt] :
      wrote(qsharp, stdout) < qsharp : QSharp | state: write&wait, script: St, AtS >
   => < qsharp : QSharp | state: idle, script: "", AtS > getLine(stdin, qsharp, "Q#> ")
   if skipLines(St) == "" .

  *** a command of a script is echoed after the prompt and then processed
  *** as if it had been typed
  crl [prompt-script] :
      wrote(qsharp, stdout) < qsharp : QSharp | state: write&wait, data: D, script: St, AtS >
   => < qsharp : QSharp | state: echoing, data: firstLine(S), script: restLines(S), AtS >
      write(stdout, qsharp, "Q#> " + firstLine(S) + "\n")
   if S := skipLines(St) /\ S =/= "" .

  rl [echoed] :
     wrote(qsharp, stdout) < qsharp : QSharp | state: echoing, data: S, AtS >
  => < qsharp : QSharp | state: idle, data: "", AtS > gotLine(qsharp, stdin, S + "\n") .

  rl [eof] :
     gotLine(qsharp, stdin, "") < qsharp : QSharp | state: idle, AtS >
  => < qsharp : QSharp | state: write&end, AtS > write(stdout, qsharp, "\n") .

  crl [parse-command] :
      gotLine(qsharp, stdin, S) < qsharp : QSharp | input: maybe, state: idle, AtS >
   => < qsharp : QSharp | input: T, state: waiting, AtS >
   if S =/= "" /\ {T, Ty} := metaParse(COMMANDS-GRAMMAR, tokenize(S), '@Command@) .

  crl [parse-command-error] :
      gotLine(qsharp, stdin, S) < qsharp : QSharp | state: idle, AtS >
   => < qsharp : QSharp | state: write&wait, AtS > write(stdout, qsharp, err("unknown command"))
   if S =/= "" /\ not (metaParse(COMMANDS-GRAMMAR, tokenize(S), '@Command@) :: ResultPair) .

  *** ---------- load: run the commands of a file ----------
  crl [load] :
      < qsharp : QSharp | input: ('load_['token[T]]), state: waiting, data: D, AtS >
   => < qsharp : QSharp | input: maybe, state: readingScript, data: "", AtS >
      openFile(fileManager, qsharp, S, "r")
   if S := printTokens(downTerm(T, 'err)) .

  rl [load-error] :
     fileError(qsharp, fileManager, Reason) < qsharp : QSharp | state: readingScript, AtS >
  => < qsharp : QSharp | state: write&wait, AtS > write(stdout, qsharp, err(Reason)) .

  rl [load-opened] :
     openedFile(qsharp, fileManager, FHIn) < qsharp : QSharp | state: readingScript, AtS >
  => < qsharp : QSharp | state: readingScript, AtS > getLine(FHIn, qsharp) .

  rl [load-line] :
     gotLine(qsharp, FHIn, TXT) < qsharp : QSharp | state: readingScript, data: D, AtS >
  => < qsharp : QSharp | state: readingScript, data: (D + TXT), AtS >
     if TXT == "" then closeFile(FHIn, qsharp) else getLine(FHIn, qsharp) fi .

  *** the commands of the file run before the ones still pending, so scripts
  *** can load other scripts
  rl [load-closed] :
     closedFile(qsharp, FHIn) < qsharp : QSharp | state: readingScript, data: D, script: St, AtS >
  => < qsharp : QSharp | state: write&wait, data: "", script: (D + "\n" + St), AtS >
     wrote(qsharp, stdout) .

  *** ---------- open ----------
  crl [open] :
      < qsharp : QSharp | input: ('open_['token[T]]), state: waiting, data: D, AtS >
   => < qsharp : QSharp | input: maybe, state: reading, data: "", AtS >
      openFile(fileManager, qsharp, S, "r")
   if S := printTokens(downTerm(T, 'err)) .

  rl [open-error] :
     fileError(qsharp, fileManager, Reason) < qsharp : QSharp | state: reading, AtS >
  => < qsharp : QSharp | state: write&wait, AtS > write(stdout, qsharp, err(Reason)) .

  rl [opened] :
     openedFile(qsharp, fileManager, FHIn) < qsharp : QSharp | state: reading, AtS >
  => < qsharp : QSharp | state: reading, AtS > getLine(FHIn, qsharp) .

  rl [got-line] :
     gotLine(qsharp, FHIn, TXT) < qsharp : QSharp | state: reading, data: D, AtS >
  => < qsharp : QSharp | state: reading, data: (D + TXT), AtS >
     if TXT == "" then closeFile(FHIn, qsharp) else getLine(FHIn, qsharp) fi .

  rl [closed] :
     closedFile(qsharp, FHIn) < qsharp : QSharp | state: reading, AtS >
  => < qsharp : QSharp | state: processing, AtS > .

  crl [loaded-ok] :
      < qsharp : QSharp | state: processing, data: D, prog: MP, mod: MOD, AtS >
   => < qsharp : QSharp | state: write&wait, data: "", prog: P, mod: MOD, AtS >
      write(stdout, qsharp, ok("Program loaded. Operations: " + opNames(P) + "\n"))
   if loaded(P) := load(upModule(MOD, false), D + "\n" + prelude) .

  crl [loaded-error] :
      < qsharp : QSharp | state: processing, data: D, mod: MOD, AtS >
   => < qsharp : QSharp | state: write&wait, data: "", mod: MOD, AtS >
      write(stdout, qsharp, err(S))
   if loadError(S) := load(upModule(MOD, false), D + "\n" + prelude) .

  *** ---------- commands on the loaded program ----------
  crl [exec] :
      < qsharp : QSharp | input: T, state: waiting, prog: MP, mod: MOD, AtS >
   => < qsharp : QSharp | input: maybe, state: write&wait, prog: MP, mod: MOD, AtS >
      write(stdout, qsharp, exec(T, MP, upModule(MOD, false)))
   if isExec(T) .

  *** ---------- module ----------
  crl [module] :
      < qsharp : QSharp | input: ('module_['token[T]]), state: waiting, mod: MOD, AtS >
   => < qsharp : QSharp | input: maybe, state: write&wait, mod: Q, AtS >
      write(stdout, qsharp, ok("Working module: " + printTokens(Q) + "\n"))
   if Q := downTerm(T, 'err) /\ upModule(Q, false) :: Module .
  crl [module-error] :
      < qsharp : QSharp | input: ('module_['token[T]]), state: waiting, AtS >
   => < qsharp : QSharp | input: maybe, state: write&wait, AtS >
      write(stdout, qsharp, err("that module is not loaded"))
   if not (upModule(downTerm(T, 'err), false) :: Module) .

  *** ---------- quit ----------
  rl [quit] :
     < qsharp : QSharp | input: 'quit.@Command@, state: waiting, AtS >
  => < qsharp : QSharp | input: maybe, state: write&end, AtS > write(stdout, qsharp, "\nBye.\n") .
  rl [q] :
     < qsharp : QSharp | input: 'q.@Command@, state: waiting, AtS >
  => < qsharp : QSharp | input: maybe, state: write&end, AtS > write(stdout, qsharp, "\nBye.\n") .

  rl [end] :
     wrote(qsharp, stdout) < qsharp : QSharp | state: write&end, AtS >
  => < qsharp : QSharp | state: finished, AtS > .

  op run : -> Configuration .
  eq run = <> < qsharp : QSharp | input: maybe, state: write&wait, data: "",
                                  prog: maybe, mod: 'QSHARP-PROPS, script: "" >
           write(stdout, qsharp, banner) .
endm

set print attribute off .
erew run .
