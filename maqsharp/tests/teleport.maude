in ../qsharp-props.maude

mod TELEPORT-PROG is
  pr QSHARP-SYNTAX .
  op prog : -> Decls .
  eq prog =
    (operation 'Teleport ('msg : Qubit, 'target : Qubit) : Unit {
        use 'reg = Qubit() ;
        'H('reg) ;
        'CNOT('reg, 'target) ;
        'CNOT('msg, 'reg) ;
        'H('msg) ;
        let 'm1 = 'M('msg) ;
        let 'm2 = 'M('reg) ;
        if 'm1 eq One { 'Z('target) ; }
        if 'm2 eq One { 'X('target) ; }
        'Reset('reg) ;
    }) .
endm

mod TELEPORT is
  pr QSHARP-PROPS .
  pr TELEPORT-PROG .
  ops a b : -> NzCpx .
  eq a * a ^* + b * b ^* = (1,0,0,0) .
  op init : -> Config .
  eq init = runWith(prog, 'Teleport, (qb(0), qb(1)),
                    (q[0]: a . |0> + b . |1>) (q[1]: |0>), 2) .
endm

*** final states
search init =>! {(qstate: Q:Qubit) (prob: P:Prob) (isEnd: true) R:Comps} .
*** counterexample: is there a final state where qubit 1 does not hold the original state?
search init =>! {(qstate: Q:Qubit) (isEnd: true) R:Comps}
  such that qubitAt(Q:Qubit, 1) =/= a . |0> + b . |1> .
*** with equality up to global phase: no counterexamples
search init =>! {(qstate: Q:Qubit) (isEnd: true) R:Comps}
  such that not eqUpToPhase(qubitAt(Q:Qubit, 1), a . |0> + b . |1>) .
