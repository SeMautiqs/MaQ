*** Minimal patch on top of smc4qc, without modifying its files.
***
*** When every qubit of an entangled block is measured and separated,
*** rmQubitAt* returns the nil matrix, leaving the ill-sorted term
***   q[nil]: nil
*** inside simplifyOne*, which then does not reduce. That empty block is emp.
***
*** Moreover, the conjugate of i is missing: (i)^* does not reduce, and without
*** it neither S† nor T† simplifies.
***
*** Finally, arithmetic operations are only declared on Complex, so a
*** probability such as 1/2 .+ -1/2 .* 1 ./ Sqrt(2) never has sort Real and
*** measurement, which requires Prob : Real, gets stuck as soon as a square
*** root appears, e.g. after H T H. We add subsort overloads on Real.

in smc4qc/symbolic-reasoning.maude

fmod SYMBOLIC-REASONING-PATCHED is
  inc SYMBOLIC-REASONING .
  eq q[(nil).NatList]: (nil).Matrix = emp .
  eq (i)^* = (-1) .* i .

  op Sqrt : PosRat -> Real [ditto] .
  op _.*_ : Real Real -> Real [ditto] .
  op _./_ : Real Real -> Real [ditto] .
  op _.+_ : Real Real -> Real [ditto] .
  op (_)^* : Real -> Real [ditto] .
endfm
